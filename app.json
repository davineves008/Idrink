{
  "expo": {
    "name": "Idrink",
    "slug": "Idrink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "idrink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ff7a00",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.davi005.Idrink"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
     [
  "expo-splash-screen",
  {
    "backgroundColor": "#ff7a00",
    "image": "./assets/images/icon.png",
    "imageWidth": 200
  }
],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8541956-d02b-424c-9f2f-155053cebddb"
      }
    }
  }
}